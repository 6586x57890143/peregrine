# Copy to .env. Never commit the real file; .gitignore already excludes it.
#
# Variables marked LATER are read by no code yet; the tag names the milestone
# that starts reading each one. Everything else is live. Setting a LATER variable
# does nothing today, but it is not silent about it: startup logs one warning
# listing every LATER variable you have set, along with its milestone, because a
# knob that is documented and ignored is indistinguishable from a knob that is
# broken.
#
# Every live variable is validated at startup and a bad value is a startup error,
# not a fallback to the default. That includes booleans: PEREGRINE_ENABLE_X=ture
# fails loudly rather than reading as "off", because "the value was not
# understood so the feature is disabled" is exactly how autonomous posting stayed
# dark for months. Errors are reported all at once, so a six-variable mistake
# takes one restart to see rather than six.

# ---------------------------------------------------------------- credentials

# Discord Developer Portal -> Bot -> Token.
#
# Peregrine needs the MESSAGE CONTENT privileged intent, which must be ticked
# under Bot in the Developer Portal. Without it Discord refuses the connection
# and the bot cannot read the messages it exists to learn from.
DISCORD_BOT_TOKEN=

# A Discord user ID that gates operator-only commands. Fails CLOSED: while this
# is empty those commands are refused for everyone, never allowed for everyone.
# This replaces a user ID that was hardcoded in main.go as the only
# authorization check in the codebase.
PEREGRINE_BOOTSTRAP_ADMIN_USER_ID=

# ------------------------------------------------------------------- storage

# Where the bbolt corpus lives.
#
# Must be an absolute path inside the mounted volume when running in a
# container. The image runs with a read-only root filesystem, so the bare
# relative default resolves against the distroless working directory and
# bbolt.Open fails. This is the single most common way to get a bot that starts,
# appears healthy, and has silently learned nothing.
PEREGRINE_DB_PATH=/data/markov.db

# In-process corpus snapshots, taken inside a bbolt read transaction via
# tx.CopyFile so they are consistent by construction. Empty dir disables them.
# There is no backup sidecar on purpose: see the comment in
# docker-compose.prod.yml for why `cp markov.db` is not a backup.
# LATER (M13)
PEREGRINE_BACKUP_DIR=/backups
# LATER (M13)
PEREGRINE_BACKUP_TICK=24h
# LATER (M13)
PEREGRINE_BACKUP_KEEP=7

# -------------------------------------------------------------------- safety

# The blocklist is data, not source: committing an explicit slur and
# illegal-content pattern list would make this repo a searchable copy of one,
# and would turn every addition into a rebuild and a public diff instead of an
# edit the operator can make mid-incident. See blocklist.example.txt.
#
# Fails CLOSED once set. A missing file, an unreadable file, a malformed line, an
# uncompilable pattern and an EMPTY file are all startup errors, because a partial
# ruleset is indistinguishable from a working one right up until the worst possible
# moment. Every bad line is reported in one pass, with its line number.
#
# Leaving it UNSET is allowed and warns loudly. The built-in baseline in
# internal/filter still applies, so a developer on a scratch corpus does not have to
# invent a slur list first, but the operator list is where the threat and
# illegal-content patterns live and it is the only part editable without a deploy.
# Do not run in a hostile channel without it.
#
# Patterns are matched against the NORMALIZED form of the text, never the raw form,
# so you do not need to enumerate leet spellings, spacing tricks or homoglyphs.
PEREGRINE_BLOCKLIST_PATH=/blocklist.txt

# Emergency stop. When set to 1/true/yes/on, every outbound message is refused
# process-wide while the bot keeps reading and learning. This is the host-level
# lever for when the bot is actively saying something awful in a live channel and
# waiting for a deploy is not acceptable. Takes effect on restart, and says so in
# the log at startup so a silent bot is never a mystery.
#
# It deliberately does NOT stop learning. During an incident the output is the
# problem, not the corpus, and stopping ingestion would also stop the bot noticing
# what is being said to it.
PEREGRINE_PAUSE_ALL_WRITES=

# How many DISTINCT authors must have produced a continuation before the bot is
# willing to generate it. This is the main anti-poisoning control: raw frequency
# means repeating a phrase is a direct write to the model, so without this one
# determined user can teach the bot to say anything. Requiring independent
# authors makes that attack need collusion instead of persistence.
#
# Too high and a quiet server generates nothing; too low and two accounts defeat
# it. Start at 2 and tune against the real active-user count.
#
# LIVE as of M7a. 0 disables the gate, which is the right value on a scratch
# corpus and a deliberate choice on a live one. Know the consequence on a YOUNG
# corpus: until several people have said similar things most continuations have a
# single author, so the bot is close to silent. That is the control working, not
# a fault, and the fix is a corpus with more people in it rather than a lower
# threshold.
PEREGRINE_MIN_DISTINCT_AUTHORS=2

# ------------------------------------------------------- generation, quality

# Sampling temperature. Higher is more chaotic. This replaces a knob called
# "Creativity" whose arithmetic inverted its own name: it was applied as an
# exponent of 1/(Creativity+0.01), so raising it toward 1 could only ever
# approach an exponent of 1.0 and never pass it, meaning the dial could not
# reach the interesting half of its own range and the sampler collapsed toward
# argmax. A chaos bot that is accidentally deterministic is the worst outcome
# here, which is why this got rewritten rather than renamed.
#
# There is deliberately no PEREGRINE_CREATIVITY, then or now. Creativity stayed a
# constant in the code rather than becoming a variable, because exposing a knob
# whose arithmetic contradicts its name would invite an operator to tune something
# broken and conclude the bot is unresponsive to it.
#
# LIVE as of M7a, range 0 to 10. 0 is argmax, which is the degenerate end of the
# dial and is roughly what the old engine did by accident. 1.0 is the model as
# estimated. Past about 3 the output is word salad even with top-k on, and the
# upper bound is generous precisely so you can see that for yourself.
PEREGRINE_TEMPERATURE=1.0

# Bonus applied to a candidate that appeared in the prompt.
#
# ITS UNITS CHANGED IN M7a AND THE OLD DEFAULT IS NOW REFUSED AT STARTUP. It used
# to be added to an unnormalized score whose scale was raw n-gram counts, so 15.0
# was sensible. Scoring is a log-probability now, where an additive 15.0
# multiplies a candidate's odds by three million and makes echoing the prompt the
# only thing the bot ever does. The valid range is 0 to 5.
#
# The variable deliberately kept its name so that a stale 15.0 in your .env is a
# startup error naming the new range. Renaming it would have let the old value
# quietly stop being read, which is indistinguishable from the bot ignoring its
# configuration.
PEREGRINE_PROMPT_RELEVANCE_BOOST=0.6

# Truncate the candidate tail before sampling. This is what keeps a high
# temperature surprising rather than word salad: cut the tail, then sample the
# surviving head hot. 0 disables.
#
# LIVE as of M7a. Applied first, then TOP_P over what survives.
PEREGRINE_TOP_K=40
# Nucleus threshold: keep the shortest leading run of candidates whose combined
# probability reaches this. 1 disables. LIVE as of M7a.
PEREGRINE_TOP_P=0.95

# Kneser-Ney absolute discount, subtracted from each observed count.
#
# LIVE as of M7a, and it must stay below 1: at 1 or above it erases every
# count-1 continuation, and in a corpus this sparse that is nearly all of them.
PEREGRINE_KN_DISCOUNT=0.75

# How far to pull Kneser-Ney back toward raw counts, 0.0 to 1.0.
#
# This knob exists because textbook KN actively fights this bot's purpose. KN
# estimates lower orders from CONTINUATION counts, the number of distinct
# contexts a token follows, which correctly demotes a word like "Francisco" that
# is common but nearly always preceded by "San". The problem is that a meme, a
# copypasta and an inside joke are statistically indistinguishable from
# "Francisco": high frequency, few distinct contexts. So pure KN would
# systematically suppress exactly the register this server runs on.
#
# 0.0 is textbook KN and maximizes conventional quality. 1.0 is raw counts.
# 0.25 leans to KN while keeping the memes. Tune on golden samples, not vibes.
#
# LIVE as of M7a. Setting this to 0 on the authority of a paper makes the output
# worse by the only metric that matters here.
PEREGRINE_KN_RAW_MIX=0.25

# Generated sentence length, in words. The old bound was 30 + rand(15), which
# is a paragraph: too long to land in a chat channel. Short and punchy reads as
# a joke, long reads as a malfunction.
# LATER (M7b)
PEREGRINE_MIN_WORDS=4
# LATER (M7b)
PEREGRINE_MAX_WORDS=18

# Highest n-gram order. Minimum 2: order 1 produced an empty prefix, which put
# the entire vocabulary into a single database key that nothing ever read.
PEREGRINE_MAX_NGRAM=5

# Window for word co-occurrence, in words. Replaces an all-pairs O(n^2) loop
# that ran inside the write transaction. 0 means unbounded and logs a warning.
# LATER (M7b)
PEREGRINE_COOCCURRENCE_WINDOW=5

# ------------------------------------------------------------------- persona

# Chance that a direct mention gets the roast persona rather than a neutral
# reply, 0.0 to 1.0.
# LATER (M7b)
PEREGRINE_ROAST_CHANCE=0.10

# What makes the bot answer unprompted when it hears its own name. Must compile
# as a Go regexp.
PEREGRINE_SELF_MENTION_PATTERN=(?i)\b(peregrine|bird)\b

# -------------------------------------------------------- engagement: aggro

# Hourly roll to pick a random active user and react to their messages for a
# while. Pure chaos, and the cheapest kind in the bot.
PEREGRINE_AGGRO_TICK=1h
PEREGRINE_AGGRO_CHANCE=0.20
PEREGRINE_AGGRO_DURATION=20m
PEREGRINE_AGGRO_EMOJI=🐦

# -------------------------------------------------------- engagement: images

# The off switch gates URL capture as well as reposting, not just the repost.
# With reposting off, the cache has no consumer, so continuing to store other
# people's media URLs in the operator's database would be liability with no
# upside.
PEREGRINE_ENABLE_IMAGE_REPOST=true

# Two rates, because there are two situations. The ambient one is deliberately
# the higher: when the bot is already answering a mention it is contributing to
# the channel anyway, so an unrelated image on top of that reply is noise rather
# than chaos.
PEREGRINE_IMAGE_REPOST_CHANCE=0.015
PEREGRINE_IMAGE_REPOST_CHANCE_DIRECT=0.01
PEREGRINE_IMAGE_CACHE_SIZE=100
# Cap per author so one user cannot fill the cache and turn the bot into their
# personal reposting service. The bot republishes these under its own name, so
# the operator wears whatever it posts.
# LATER (M11)
PEREGRINE_IMAGE_MAX_PER_AUTHOR=5

# ------------------------------------------------- engagement: autonomous post

# Posting unprompted. Comma-separated channel IDs, and an empty list means no
# channels: a bot that speaks unprompted must never do so somewhere nobody
# named. Enabling the feature with an empty list is a STARTUP ERROR rather than
# silence, because the previous arrangement had the feature disabled AND the
# list empty, so flipping either one alone produced nothing and no explanation.
PEREGRINE_ENABLE_AUTONOMOUS_POST=false
PEREGRINE_AUTONOMOUS_POST_CHANNELS=

# Its own ticker. Both this loop and the history backfill were driven by one
# AutonomyTick constant, so tuning how often the bot re-read history also changed
# how often it spoke unprompted: two unrelated decisions on one dial, and the
# second one invisible. Defaults to the 10m they used to share.
PEREGRINE_AUTONOMOUS_POST_TICK=10m

# Chance to skip a tick entirely, for pacing that does not look mechanical.
PEREGRINE_AUTONOMOUS_SKIP_CHANCE=0.90

# ---------------------------------------------------- engagement: word games

PEREGRINE_ENABLE_WORD_GAMES=false
PEREGRINE_WORDGAME_FREQUENCY_MODE=interval
# 2m is the value the code has always used and it is a leftover from testing
# rather than a decision. M11 picks a real one when word games are turned on
# deliberately.
PEREGRINE_WORDGAME_INTERVAL=2m
# Overrides the embedded word list. Empty uses the embedded one, which
# is the normal case and cannot fail at runtime.
PEREGRINE_WORDGAME_DICTIONARY=

# ------------------------------------------------------------------- ingest

# Backfill from channel history. The old loop re-scanned the whole trailing 24h
# every 10 minutes and deduplicated against a 10,000-key window, so on a busy
# server older messages were evicted and then learned AGAIN, double-counting
# n-grams. M9 replaces the rescan with per-channel high-water cursors.
PEREGRINE_INGEST_TICK=10m
PEREGRINE_INGEST_LOOKBACK=24h
# LATER (M9)
PEREGRINE_INGEST_GUILD_CONCURRENCY=4
# Was unbounded: one goroutine per channel per guild, each paging 50 messages.
# LATER (M9)
PEREGRINE_INGEST_CHANNEL_CONCURRENCY=4
PEREGRINE_INGEST_BATCH_DELAY=500ms

# Channels the bot ignores entirely, comma-separated IDs.
# LATER (M10)
PEREGRINE_IGNORE_CHANNELS=

# ------------------------------------------------------------------ runtime

# Bounded worker pool for incoming messages. Replaced an unbounded goroutine per
# message that shared a WaitGroup with the shutdown path, which could panic on
# exit and let handlers keep using the database after it closed. A full queue
# drops and counts rather than blocking, because best-effort chat is the honest
# semantics and an unbounded queue is just a slower crash. The drop total is
# reported on shutdown and in the status line.
#
# Keep the worker count low. bbolt serializes every write transaction
# process-wide, so past a handful of workers the extra concurrency buys lock
# contention rather than throughput.
PEREGRINE_MESSAGE_WORKERS=4
PEREGRINE_MESSAGE_QUEUE=256

PEREGRINE_STATUS_TICK=5m

# LATER (M8)
# LATER (M8)
#
# These were live and off-by-default until M6b, and are now read by no code at
# all, because the clustering loop is gone rather than merely disabled.
#
# Three reasons, and any one of them is sufficient. The pass has never worked: it
# writes cluster members string-keyed and the generation path read them into a map
# with an integer key type, so every unmarshal failed and both consumers silently
# skipped it (SPEC.md section 8, finding 27). It takes a raw bbolt handle, which
# nothing outside internal/storage can hold since M6b. And it reads the name-topic
# index as a JSON map per name, which the composite-key layout does not store.
#
# M8 rebuilds it and these become live again. Setting one today produces a startup
# warning and nothing else.
PEREGRINE_ENABLE_CLUSTERING=false
PEREGRINE_CLUSTERING_TICK=24h

# How often to check whether the weekly leaderboard is due for a reset. The reset
# itself is weekly; this is only the polling interval.
PEREGRINE_LEADERBOARD_CHECK_TICK=1h

PEREGRINE_MAX_HISTORY=10000

# debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------ transcription

# OFF by default, and the default deliberately differs from the old in-code
# constant. Transcription shells out to ffmpeg and whisper-cli and needs a
# 465 MiB model, none of which exist in a distroless image that has no shell at
# all. It stays a Windows-local development feature; the binaries and the model
# are gitignored and fetched by hand. See README.
#
# Enabling this in a container also requires a writable tmpfs at /tmp.
PEREGRINE_ENABLE_TRANSCRIPTION=false
# LATER (M12)
PEREGRINE_WHISPER_MODEL=voicenotes/models/ggml-small.bin
# LATER (M12)
PEREGRINE_VOICENOTES_DIR=voicenotes
# LATER (M12)
PEREGRINE_TRANSCRIPTION_TIMEOUT=2m
